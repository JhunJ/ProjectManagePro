{
  "name": "projectmanagepro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:provider:audit",
    "dev": "node scripts/run-dev-with-env.mjs",
    "build": "next build --webpack",
    "start": "node scripts/run-start-with-env.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma db push --skip-generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:provider:audit": "node scripts/db-provider-audit.mjs",
    "db:local:init": "node scripts/local-postgres.mjs init",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "db:url:check": "node scripts/setup-db-env.mjs --check",
    "db:url:setup": "node scripts/setup-db-env.mjs --interactive",
    "db:url:local": "node scripts/setup-db-env.mjs --set-local",
    "db:url:server": "node scripts/setup-db-env.mjs --set-server",
    "db:docker:up": "docker compose up -d",
    "db:docker:down": "docker compose down",
    "db:url:docker": "node scripts/setup-db-env.mjs --set-docker",
    "db:docker:prepare": "node scripts/docker-prepare.mjs",
    "db:sqlite:export": "node scripts/export-sqlite-snapshot.mjs",
    "db:sqlite:import": "node scripts/import-sqlite-snapshot.mjs",
    "db:sqlite:migrate": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^6.0.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-virtual": "^3.13.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
